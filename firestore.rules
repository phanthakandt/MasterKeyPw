rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // บัญชีที่ถูกแบน: ผู้ดูแลสร้างเอกสาร banned/{uid} ใน Firebase Console (เนื้อหาอะไรก็ได้)
    // เจ้าของบัญชีอ่านได้อย่างเดียว เพื่อให้แอปขึ้นข้อความว่าถูกระงับ ไม่มีใครเขียนผ่านแอปได้
    match /banned/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // หนึ่งผู้ใช้ = หนึ่งเอกสาร เก็บเฉพาะ blob ที่เข้ารหัสแล้ว
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
      }
      // ตู้ใหม่และการเขียนต้องมาจากบัญชี Google เท่านั้น
      // (บัญชีจากรุ่น Master Key อ่านและลบตู้ตัวเองได้ เพื่อให้แอปย้ายเข้าบัญชี Google)
      function viaGoogle() {
        return request.auth.token.firebase.sign_in_provider == 'google.com';
      }
      function validBlob() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iter', 'salt', 'iv', 'ct', 'updatedAt'])
          && d.keys().hasAll(['v', 'iter', 'salt', 'iv', 'ct', 'updatedAt'])
          && d.v is int && d.v >= 1
          && d.iter is int && d.iter >= 600000          // ห้ามลดรอบ PBKDF2
          && d.salt is string && d.salt.size() >= 16 && d.salt.size() <= 64
          && d.iv is string && d.iv.size() == 16          // 12 ไบต์ → base64 16 ตัว
          && d.ct is string && d.ct.size() > 0 && d.ct.size() < 900000
          && d.updatedAt == request.time;                 // ต้องเป็น serverTimestamp()
      }

      allow read: if isOwner();
      allow create: if isOwner() && viaGoogle() && validBlob();
      // IV ต้องเปลี่ยนทุกครั้งที่เขียน (กัน IV ซ้ำ)
      allow update: if isOwner() && viaGoogle() && validBlob() && request.resource.data.iv != resource.data.iv;
      // แอปลบเฉพาะตู้ที่ว่างตอนออกจากตู้ และตู้รุ่นเก่าที่ย้ายมาแล้ว (ข้อมูลเข้ารหัสอยู่ เซิร์ฟเวอร์ตรวจไม่ได้ว่าว่างจริง จึงให้สิทธิ์เจ้าของ)
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
